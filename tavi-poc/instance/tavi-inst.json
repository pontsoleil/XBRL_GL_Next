{
  "documentInfo": {
    "documentType": "https://xbrl.org/2021/xbrl-csv",
    "namespaces": {
      "cor": "https://xbrl.org/gl-next/cor",
      "test": "https://example.com/entities/test",
      "iso4217": "http://www.xbrl.org/2003/iso4217"
    },
    "taxonomy": [
      "../taxonomy/tavi-tax.json"
    ]
  },
  "tableTemplates": {
    "accountingEntries": {
      "columns": {
        "dHeader": {},
        "dDetail": {},
        "entryNumber": {
          "dimensions": {
            "concept": "cor:entryNumber"
          }
        },
        "entryDate": {
          "dimensions": {
            "concept": "cor:entryDate"
          }
        },
        "drCrIndicator": {
          "dimensions": {
            "concept": "cor:drCrIndicator"
          }
        },
        "accountCode": {
          "dimensions": {
            "concept": "cor:accountCode"
          }
        },
        "accountName": {
          "dimensions": {
            "concept": "cor:accountName"
          }
        },
        "amount": {
          "decimals": 0,
          "dimensions": {
            "concept": "cor:amount",
            "unit": "iso4217:JPY"
          }
        },
        "description": {
          "dimensions": {
            "concept": "cor:description"
          }
        }
      },
      "dimensions": {
        "entity": "test:ENTITY",
        "period": "2026-10-10T00:00:00",
        "cor:dHeader": "$dHeader",
        "cor:dDetail": "$dDetail"
      }
    }
  },
  "tables": {
    "accountingEntries": {
      "template": "accountingEntries",
      "url": "tavi-inst.csv"
    }
  }
}
