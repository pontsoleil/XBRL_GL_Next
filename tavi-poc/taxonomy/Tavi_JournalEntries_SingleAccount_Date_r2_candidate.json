      },
      {
        "forObject": "cor:p_cor_entryHeader",
        "labelType": "xbrl:documentation",
        "language": "en",
        "value": "Parent for entry headers/journal entry headers."
      },
      {
        "forObject": "cor:p_cor_entryHeader",
        "labelType": "xbrl:documentation",
        "language": "ja",
        "value": "エントリヘッダー/仕訳記入ヘッダーの親タグ。"
      },
      {
        "forObject": "cor:headerEntryDate",
        "labelType": "xbrl:documentation",
        "language": "en",
        "value": "The accounting date on which the journal entry as a whole is recognised in the accounting records. This date applies to all detail lines within the entry."
      },
      {
        "forObject": "cor:headerEntryDate",
        "labelType": "xbrl:documentation",
        "language": "ja",
        "value": "仕訳全体を会計帳簿上認識する会計日付。仕訳内のすべての明細行に適用する。"
      },
      {
        "forObject": "cor:entryId",
        "labelType": "xbrl:documentation",
        "language": "en",
        "value": "Identifier within source journal"
      },
      {
        "forObject": "cor:entryId",
        "labelType": "xbrl:documentation",
        "language": "ja",
        "value": "元仕訳帳中の識別子。"
      },
      {
        "forObject": "cor:p_cor_entryDetail",
        "labelType": "xbrl:documentation",
        "language": "en",
        "value": "Parent for entry detail"
      },
      {
        "forObject": "cor:p_cor_entryDetail",
        "labelType": "xbrl:documentation",
        "language": "ja",
        "value": "仕訳明細の親タグ。"
      },
      {
        "forObject": "cor:entryDetailDescription",
        "labelType": "xbrl:documentation",
        "language": "en",
        "value": "Description of this line of detail only"
      },
      {
        "forObject": "cor:entryDetailDescription",
        "labelType": "xbrl:documentation",
        "language": "ja",
        "value": "この明細行のみに対する説明。"
      },
      {
        "forObject": "cor:accountNumber",
        "labelType": "xbrl:documentation",
        "language": "en",
        "value": "Main account - the code used to identify the accounting bucket the entry has been assigned to. Examples might be 1000 for Cash, 567GAAZ for Sales Expense or Z for tax payments. Identifiers such as department, branch, division, manager, or other modifiers are noted in the Subaccount area. Before needing to post, account is not necessary. Posting to the general ledger almost always requires an entry here."
      },
      {
        "forObject": "cor:accountNumber",
        "labelType": "xbrl:documentation",
        "language": "ja",
        "value": "主勘定科目。仕訳が関連する会計バケットを特定するためのコード。例えば、現金を表す1000、販売費を表す567GAAZ、税を表すZ。_x005F_x000D_\n部門、支店、事業部、マネージャ、その他の識別子は、Subaccount領域に記述される。転記の必要がなければ、勘定科目は必要ではない。総勘定元帳に転記するにはほとんどの場合必要。"
      },
      {
        "forObject": "cor:accountDescription",
        "labelType": "xbrl:documentation",
        "language": "en",
        "value": "Description of accountMainID - the human readable describer that accompanies the code used in accountMainID"
      },
      {
        "forObject": "cor:accountDescription",
        "labelType": "xbrl:documentation",
        "language": "ja",
        "value": "主勘定科目コードの説明。主勘定科目コードとして使用されるコードについての、人が読める記述。"
      },
      {
        "forObject": "cor:monetaryAmount",
        "labelType": "xbrl:documentation",
        "language": "en",
        "value": "This field (amount) represents the primary monetary amount related to the  subject of the entryDetail line. There is one primary monetary amount per entryDetail class. It may, for example, represent the amount of one line of a journal entry, the balance on a document, or the extended amount of a line item on an invoice. Amount is not required if detailed entry is used for non-financial work and other elements are populated, in particular measurableQuantity. The amount field is a signed number (either positive or negative itself) and used in conjunction with a separate signOfAmount and a separate debitCreditCode, which together are considered for understanding the monetary amount. The unit of measure is determined by amountCurrency if present, and by the default or home currency if amountCurrency is not present."
      },
      {
        "forObject": "cor:monetaryAmount",
        "labelType": "xbrl:documentation",
        "language": "ja",
        "value": "entryDetailの代表的な金額を示す。entryDetailごとにひとつの値を持つ。たとえば、仕訳帳の行、残高、請求書の行の金額。明細が会計業務用でなく、measurableQuantityなどの他の要素が設定されている場合は不要。符号付数値であり、金額を解釈するために用意されたsignOfAmountおよびdebitCreditCodeとあわせて使用される。通貨単位はamountCurrencyで決定される。amountCurrencyが指定されない場合は、既定または自国の通貨単位となる。"
      },
      {
        "forObject": "cor:debitCreditIndicator",
        "labelType": "xbrl:documentation",
        "language": "en",
        "value": "Optional identifier of whether the amount is a (D)ebit, a (C)redit or Undefined"
      },
      {
        "forObject": "cor:debitCreditIndicator",
        "labelType": "xbrl:documentation",
        "language": "ja",
        "value": "金額が借方か貸方か不定かを示す識別子。_x005F_x000D_\n[設定値のリスト]_x005F_x000D_\n(D)、(C)、(debit：借方)、(credit：貸方)、(undefined：不定)"
      }
