diff --git a/arelle/plugin/OimTaxonomy/ViewStructuredTidyData.py b/arelle/plugin/OimTaxonomy/ViewStructuredTidyData.py
new file mode 100644
index 0000000000000000000000000000000000000000..edb80c2816bc1c5fed89fc481fbde49481ea068a
--- /dev/null
+++ b/arelle/plugin/OimTaxonomy/ViewStructuredTidyData.py
@@ -0,0 +1,328 @@
+"""
+See COPYRIGHT.md for copyright information.
+"""
+from collections import defaultdict
+
+from arelle import ViewWinTree
+from arelle.ModelValue import qname
+
+from .XbrlConst import xbrl
+from .XbrlCube import XbrlCube
+from .XbrlDimension import XbrlDomain
+from .XbrlReport import XbrlFact
+from .XbrlTableTemplate import XbrlTableTemplate
+
+
+_QN_CONCEPT = qname(xbrl, "xbrl:concept")
+
+
+def _loadingContext(xbrlDts):
+    return getattr(xbrlDts, "xbrlCsvLoadingContext", None)
+
+
+def _resolveQName(value, namespaces):
+    if hasattr(value, "namespaceURI") and hasattr(value, "localName"):
+        return value
+    return qname(str(value), dict(namespaces))
+
+
+def _metadataNamespaces(xbrlDts):
+    context = _loadingContext(xbrlDts)
+    metadata = getattr(context, "metadata", None)
+    documentInfo = getattr(metadata, "document_info", None)
+    namespaces = getattr(documentInfo, "namespaces", None)
+    return namespaces or {}
+
+
+def _taxonomyTemplates(xbrlDts):
+    return [obj for obj in xbrlDts.namedObjects.values() if isinstance(obj, XbrlTableTemplate)]
+
+
+def _metadataTemplates(xbrlDts):
+    context = _loadingContext(xbrlDts)
+    metadata = getattr(context, "metadata", None)
+    return getattr(metadata, "table_templates", {}) or {}
+
+
+def canViewStructuredTidyData(xbrlDts):
+    """Return True only for the current single-template native report scope."""
+    if not getattr(xbrlDts, "facts", None):
+        return False
+    if _loadingContext(xbrlDts) is None:
+        return False
+    taxonomyTemplates = _taxonomyTemplates(xbrlDts)
+    metadataTemplates = _metadataTemplates(xbrlDts)
+    return len(taxonomyTemplates) == 1 and len(metadataTemplates) == 1
+
+
+def viewStructuredTidyData(xbrlDts, tabWin):
+    if not canViewStructuredTidyData(xbrlDts):
+        return None
+    xbrlDts.modelManager.showStatus(_("viewing Structured Tidy Data"))
+    view = ViewStructuredTidyData(xbrlDts, tabWin, "Structured Tidy Data")
+    view.view()
+    view.blockViewModelObject = 0
+    view.treeView.bind("<ButtonRelease-1>", view.cellSelect, "+")
+    menu = view.contextMenu()
+    view.menuAddClipboard()
+    return view
+
+
+class ViewStructuredTidyData(ViewWinTree.ViewTree):
+    """Pivot native OIM facts into the Structured Tidy representation."""
+
+    def __init__(self, xbrlDts, tabWin, header):
+        super(ViewStructuredTidyData, self).__init__(xbrlDts, tabWin, header, True, None)
+        self.xbrlDts = xbrlDts
+        self.blockViewModelObject = 0
+        self.cellFacts = {}
+        self.factCells = defaultdict(list)
+        self.displayColumns = []
+
+    @staticmethod
+    def _domainMembers(domain):
+        if not isinstance(domain, XbrlDomain):
+            return set()
+        members = set()
+        visited = set()
+        roots = list(domain.relationshipRoots or ())
+        if getattr(domain, "root", None) is not None and domain.root not in roots:
+            roots.insert(0, domain.root)
+        stack = list(roots)
+        while stack:
+            source = stack.pop()
+            if source in visited:
+                continue
+            visited.add(source)
+            for relationship in domain.relationshipsFrom.get(source, ()):
+                target = relationship.target
+                members.add(target)
+                if target not in visited:
+                    stack.append(target)
+        return members
+
+    def _cubeDefinitions(self):
+        cubes = []
+        for obj in self.xbrlDts.namedObjects.values():
+            if not isinstance(obj, XbrlCube):
+                continue
+            conceptDimension = None
+            occurrenceDimensions = []
+            for cubeDimension in obj.cubeDimensions:
+                if cubeDimension.dimensionName == _QN_CONCEPT:
+                    conceptDimension = cubeDimension
+                else:
+                    occurrenceDimensions.append(cubeDimension.dimensionName)
+            if conceptDimension is None or not getattr(conceptDimension, "domainName", None):
+                continue
+            domain = self.xbrlDts.namedObjects.get(conceptDimension.domainName)
+            conceptMembers = self._domainMembers(domain)
+            if conceptMembers:
+                cubes.append((obj, frozenset(conceptMembers), tuple(occurrenceDimensions)))
+        return cubes
+
+    def _templateDefinition(self):
+        taxonomyTemplate = _taxonomyTemplates(self.xbrlDts)[0]
+        metadataTemplate = next(iter(_metadataTemplates(self.xbrlDts).values()))
+        taxonomyColumns = list(taxonomyTemplate.columns.keys())
+        metadataColumns = list(metadataTemplate.columns.keys())
+        if taxonomyColumns != metadataColumns:
+            self.xbrlDts.error(
+                "oimt:structuredTidyColumnMismatch",
+                _("Structured Tidy taxonomy and metadata column order differ."),
+            )
+            return None
+
+        namespaces = _metadataNamespaces(self.xbrlDts)
+        dimensionColumns = {}
+        for dimensionName, columnParameter in taxonomyTemplate.dimensions.items():
+            if isinstance(columnParameter, str) and columnParameter.startswith("$"):
+                dimensionColumns[_resolveQName(dimensionName, namespaces)] = columnParameter[1:]
+
+        conceptColumns = {}
+        for columnName, columnDefinition in taxonomyTemplate.columns.items():
+            if not isinstance(columnDefinition, dict):
+                continue
+            dimensions = columnDefinition.get("dimensions", {})
+            conceptValue = dimensions.get("xbrl:concept")
+            if conceptValue is None:
+                conceptValue = dimensions.get("concept")
+            if conceptValue is None:
+                continue
+            conceptName = _resolveQName(conceptValue, namespaces)
+            if conceptName in conceptColumns:
+                self.xbrlDts.error(
+                    "oimt:structuredTidyConceptColumnAmbiguity",
+                    _("Structured Tidy concept %(concept)s maps to more than one column."),
+                    concept=conceptName,
+                )
+                return None
+            conceptColumns[conceptName] = columnName
+
+        return taxonomyColumns, dimensionColumns, conceptColumns
+
+    @staticmethod
+    def _sortValue(value):
+        if value is None:
+            return (0, 0)
+        try:
+            return (0, int(value))
+        except (TypeError, ValueError):
+            return (1, str(value))
+
+    def _rowSortKey(self, row):
+        dimensionValues = row["dimensions"]
+        ordered = []
+        for columnName in self.displayColumns:
+            if columnName not in self.dimensionColumnNames:
+                continue
+            value = dimensionValues.get(self.dimensionColumnNames[columnName])
+            if columnName == self.primaryOccurrenceColumn:
+                ordered.append(self._sortValue(value))
+            else:
+                ordered.append((0, value is not None))
+                ordered.append(self._sortValue(value))
+        return tuple(ordered)
+
+    def _reconstructRows(self):
+        templateDefinition = self._templateDefinition()
+        if templateDefinition is None:
+            return None
+        columns, dimensionColumns, conceptColumns = templateDefinition
+        self.displayColumns = columns
+        self.dimensionColumnNames = {columnName: dimensionName for dimensionName, columnName in dimensionColumns.items()}
+        occurrenceColumns = [columnName for columnName in columns if columnName in self.dimensionColumnNames]
+        if not occurrenceColumns:
+            self.xbrlDts.error(
+                "oimt:structuredTidyMissingOccurrenceDimension",
+                _("Structured Tidy template has no occurrence-dimension columns."),
+            )
+            return None
+        self.primaryOccurrenceColumn = occurrenceColumns[0]
+
+        cubeDefinitions = self._cubeDefinitions()
+        rows = {}
+        for fact in self.xbrlDts.facts.values():
+            if not isinstance(fact, XbrlFact):
+                continue
+            lexicalConcept = fact.dimensions.get(_QN_CONCEPT)
+            if lexicalConcept is None:
+                continue
+            namespaces = _metadataNamespaces(self.xbrlDts)
+            conceptName = _resolveQName(lexicalConcept, namespaces)
+            columnName = conceptColumns.get(conceptName)
+            if columnName is None:
+                continue
+
+            customDimensions = {
+                dimensionName
+                for dimensionName in fact.dimensions
+                if getattr(dimensionName, "namespaceURI", None) != xbrl
+            }
+            matchingCubes = [
+                (cube, occurrenceDimensions)
+                for cube, conceptMembers, occurrenceDimensions in cubeDefinitions
+                if conceptName in conceptMembers and customDimensions == set(occurrenceDimensions)
+            ]
+            if len(matchingCubes) != 1:
+                self.xbrlDts.error(
+                    "oimt:structuredTidyCubeAmbiguity",
+                    _("Structured Tidy fact %(fact)s resolves to %(count)s cubes."),
+                    fact=fact.id,
+                    count=len(matchingCubes),
+                )
+                return None
+
+            cube, occurrenceDimensions = matchingCubes[0]
+            occurrenceValues = tuple((dimensionName, fact.dimensions.get(dimensionName)) for dimensionName in occurrenceDimensions)
+            rowKey = (cube.name, occurrenceValues)
+            row = rows.setdefault(rowKey, {"cube": cube, "dimensions": dict(occurrenceValues), "facts": {}})
+            if columnName in row["facts"]:
+                self.xbrlDts.error(
+                    "oimt:structuredTidyDuplicateFact",
+                    _("Structured Tidy row has more than one fact for column %(column)s."),
+                    column=columnName,
+                )
+                return None
+            row["facts"][columnName] = fact
+
+        return sorted(rows.values(), key=self._rowSortKey)
+
+    def view(self):
+        rows = self._reconstructRows()
+        if rows is None:
+            return
+        self.clearTreeView()
+        self.cellFacts.clear()
+        self.factCells.clear()
+
+        firstColumn = self.displayColumns[0]
+        remainingColumns = tuple(self.displayColumns[1:])
+        self.treeView["columns"] = remainingColumns
+        self.treeView.heading("#0", text=firstColumn)
+        self.treeView.column("#0", width=110, anchor="w")
+        for columnName in remainingColumns:
+            self.treeView.heading(columnName, text=columnName)
+            self.treeView.column(columnName, width=140, anchor="w")
+        self.treeView["displaycolumns"] = remainingColumns
+
+        for rowNumber, row in enumerate(rows, start=1):
+            values = {}
+            for columnName in self.displayColumns:
+                dimensionName = self.dimensionColumnNames.get(columnName)
+                if dimensionName is not None:
+                    value = row["dimensions"].get(dimensionName, "")
+                else:
+                    fact = row["facts"].get(columnName)
+                    value = "" if fact is None or fact.value is None else fact.value
+                values[columnName] = value
+
+            node = self.treeView.insert(
+                "",
+                "end",
+                f"structuredTidy_{rowNumber}",
+                text=str(values[firstColumn]),
+                tags=("odd" if rowNumber & 1 else "even",),
+            )
+            for columnName in remainingColumns:
+                self.treeView.set(node, columnName, str(values[columnName]))
+            for columnName, fact in row["facts"].items():
+                self.cellFacts[(node, columnName)] = fact
+                self.factCells[fact.dtsObjectIndex].append((node, columnName))
+
+    def cellSelect(self, event):
+        if self.blockViewModelObject:
+            return
+        node = self.treeView.identify_row(event.y)
+        columnId = self.treeView.identify_column(event.x)
+        if not node or not columnId:
+            return
+        if columnId == "#0":
+            columnIndex = 0
+        else:
+            try:
+                columnIndex = int(columnId[1:])
+            except (TypeError, ValueError):
+                return
+        if columnIndex >= len(self.displayColumns):
+            return
+        columnName = self.displayColumns[columnIndex]
+        fact = self.cellFacts.get((node, columnName))
+        if fact is not None:
+            self.xbrlDts.viewTaxonomyObject(fact)
+
+    def viewModelObject(self, txmyObj):
+        if self.blockViewModelObject or not isinstance(txmyObj, XbrlFact):
+            return
+        cells = self.factCells.get(txmyObj.dtsObjectIndex)
+        if not cells:
+            return
+        node, _columnName = cells[0]
+        if not self.treeView.exists(node):
+            return
+        self.blockViewModelObject += 1
+        try:
+            self.treeView.see(node)
+            self.treeView.selection_set(node)
+        finally:
+            self.blockViewModelObject -= 1
