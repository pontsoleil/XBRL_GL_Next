diff --git a/arelle/plugin/OimTaxonomy/XbrlReport.py b/arelle/plugin/OimTaxonomy/XbrlReport.py
index 27cc968f617cdaad2fef1199395a721e6f551902..b21e37bf424ceceffd6689878e147f669352f890 100644
--- a/arelle/plugin/OimTaxonomy/XbrlReport.py
+++ b/arelle/plugin/OimTaxonomy/XbrlReport.py
@@ -22,3 +22,117 @@ def addReportProperties(dts: XbrlDtsType):
     dts.linkTypes: dict[str, AnyURI] = OrderedDict()
     dts.linkGroups: dict[str, AnyURI] = OrderedDict()
     dts.facts: dict[str, XbrlFact] = OrderedDict()
+
+
+class NativeOimReportBackend:
+    """Tavi resolver and fact sink for the existing OIM CSV front-end."""
+
+    def __init__(self, dts):
+        self.dts = dts
+
+    def resolveConcept(self, name):
+        from .XbrlConcept import XbrlConcept
+        obj = self.dts.namedObjects.get(name)
+        return obj if isinstance(obj, XbrlConcept) else None
+
+    def resolveDimension(self, name):
+        from .XbrlDimension import XbrlDimension
+        obj = self.dts.namedObjects.get(name)
+        return obj if isinstance(obj, XbrlDimension) else None
+
+    def prepareReport(self, linkTypes, linkGroups):
+        addReportProperties(self.dts)
+        self.dts.linkTypes.update(linkTypes)
+        self.dts.linkGroups.update(linkGroups)
+
+    def _dataType(self, name):
+        from .XbrlConcept import XbrlDataType
+        from arelle.oim.Load import OIMException
+        obj = self.dts.namedObjects.get(name)
+        if not isinstance(obj, XbrlDataType) or obj.xsBaseType(self.dts) is None:
+            raise OIMException("oime:unsupportedConceptDataType",
+                               _("Native report datatype cannot be resolved: %(dataType)s"), dataType=name)
+        return obj
+
+    def _validateValue(self, obj, value, dataType, namespaces, path):
+        from .ValidateDTS import validateValue
+        self._dataType(dataType)
+        previousErrors = len(self.dts.errors)
+        validateValue(self.dts, obj.taxonomy, obj, value, dataType, path)
+        return len(self.dts.errors) == previousErrors
+
+    def validateConceptValue(self, concept, value, namespaces):
+        if value is None:
+            if concept.nillable is False:
+                self.dts.error("oime:invalidFactValue", _("Nil value for non-nillable concept %(concept)s"), concept=concept.name)
+                return False
+            return True
+        return self._validateValue(concept, value, concept.dataType, namespaces, "/value")
+
+    def validateTypedDimValue(self, dimension, value, namespaces):
+        from arelle.oim.Load import OIMException
+        if dimension.domainDataType is None:
+            raise OIMException("oime:unsupportedDimensionDataType",
+                               _("Native report dimension requires a domain datatype: %(dimension)s"), dimension=dimension.name)
+        return self._validateValue(dimension, value, dimension.domainDataType, namespaces, "/value")
+
+    def createFact(self, factId, fact, namespaces, produced, invalidReferenceTarget):
+        from arelle.ModelValue import qname
+        from arelle.XbrlConst import isNumericXsdType
+        from .XbrlConst import xbrl
+        dimensions = fact["dimensions"]
+        for name, value in dimensions.items():
+            if value is invalidReferenceTarget:
+                produced.invalidReferenceTarget = name
+                return None
+            produced.dimensionsUsed.add(name)
+        concept = self.resolveConcept(qname(dimensions["concept"], namespaces))
+        if concept is None:
+            self.dts.error("oime:unknownConcept", _("Native report concept not found: %(concept)s"), concept=dimensions["concept"])
+            return None
+        if not self.validateConceptValue(concept, fact.get("value"), namespaces):
+            return None
+        nativeDimensions = {}
+        for name, value in dimensions.items():
+            if ":" in name:
+                key = qname(name, namespaces)
+                dimension = self.resolveDimension(key)
+                if dimension is None:
+                    self.dts.error("oime:unknownDimension", _("Native report dimension not found: %(dimension)s"), dimension=name)
+                    return None
+                if not self.validateTypedDimValue(dimension, value, namespaces):
+                    return None
+            else:
+                key = qname(xbrl, "xbrl:" + name)
+            nativeDimensions[key] = value
+        numeric = isNumericXsdType(self._dataType(concept.dataType).xsBaseType(self.dts))
+        if not numeric and ("unit" in dimensions or "decimals" in fact):
+            self.dts.error("oime:misplacedUnitDimension", _("Unit or decimals on non-numeric concept %(concept)s"), concept=concept.name)
+            return None
+        if "decimals" in fact:
+            produced.dimensionsUsed.add("decimals")
+            if fact["decimals"] is invalidReferenceTarget:
+                produced.invalidReferenceTarget = "decimals"
+                return None
+        nativeFact = XbrlFact(dtsObjectIndex=len(self.dts.xbrlObjects))
+        nativeFact.report = self.dts
+        nativeFact.id = factId
+        nativeFact.value = fact.get("value")
+        nativeFact.decimals = fact.get("decimals") if numeric and nativeFact.value is not None else None
+        nativeFact.dimensions = nativeDimensions
+        nativeFact.links = fact.get("links", {})
+        self.dts.xbrlObjects.append(nativeFact)
+        self.dts.facts[factId] = nativeFact
+        return nativeFact
+
+    def finishReport(self, footnotes):
+        # Retain CSV links in their native OIM type/group/source/target structure.
+        for links in footnotes:
+            for linkType, groups in links.items():
+                for linkGroup, sources in groups.items():
+                    for source, targets in sources.items():
+                        if (linkType not in self.dts.linkTypes or linkGroup not in self.dts.linkGroups
+                                or source not in self.dts.facts or any(t not in self.dts.facts for t in targets)):
+                            self.dts.error("xbrlce:invalidLinkTarget", _("Native report link cannot be resolved from %(source)s"), source=source)
+                            continue
+                        self.dts.facts[source].links.setdefault(linkType, {}).setdefault(linkGroup, []).extend(targets)
