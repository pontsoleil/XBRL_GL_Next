      <element ref="cor:totalCredits" minOccurs="0"/>
      <element ref="cor:typeOfDifferenceBetweenBookAndTax" minOccurs="0"/>
      <element ref="cor:eliminationCode" minOccurs="0"/>
      <element ref="cor:budgetScenarioPeriodStart" minOccurs="0"/>
      <element ref="cor:budgetScenarioPeriodEnd" minOccurs="0"/>
      <element ref="cor:scenarioDescription" minOccurs="0"/>
      <element ref="cor:scenarioCode" minOccurs="0"/>
      <element ref="cor:budgetAllocationCode" minOccurs="0"/>
      <element ref="cor:idForReversingStandardOrMasterEntry" minOccurs="0"/>
      <element ref="cor:recurringStandardDescription" minOccurs="0"/>
      <element ref="cor:frequencyInterval" minOccurs="0"/>
      <element ref="cor:frequencyUnit" minOccurs="0"/>
      <element ref="cor:repetitionsRemaining" minOccurs="0"/>
      <element ref="cor:nextDateRepeat" minOccurs="0"/>
      <element ref="cor:lastDateRepeat" minOccurs="0"/>
      <element ref="cor:endDateOfRepeatingEntry" minOccurs="0"/>
      <element ref="cor:reverse" minOccurs="0"/>
      <element ref="cor:reversingDate" minOccurs="0"/>
      <element ref="cor:entryNumberCounter" minOccurs="0"/>
      <element ref="cor:entryDetail" minOccurs="0" maxOccurs="unbounded"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="entryDetailComplexType">
    <sequence>
      <element ref="cor:lineNumber" minOccurs="0"/>
      <element ref="cor:lineNumberCounter" minOccurs="0"/>
      <element ref="cor:postingDate" minOccurs="0"/>
      <element ref="cor:memoLine" minOccurs="0"/>
      <element ref="cor:detailDocumentType" minOccurs="0"/>
      <element ref="cor:documentTypeDescription" minOccurs="0"/>
      <element ref="cor:detailDocument" minOccurs="0"/>
      <element ref="cor:documentDate" minOccurs="0"/>
      <element ref="cor:receivedDate" minOccurs="0"/>
      <element ref="cor:documentLocation" minOccurs="0"/>
      <element ref="cor:postingStatus" minOccurs="0"/>
      <element ref="cor:postingStatusDescription" minOccurs="0"/>
      <element ref="cor:headerDescription" minOccurs="0"/>
      <element ref="cor:acknowledgementDate" minOccurs="0"/>
      <element ref="cor:confirmationDate" minOccurs="0"/>
      <element ref="cor:measurableClassId" minOccurs="0"/>
      <element ref="cor:measurableClassDescription" minOccurs="0"/>
      <element ref="cor:geospatialCoordinate" minOccurs="0"/>
      <element ref="taf:detailOriginatingDriginatingDocument" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="cor:detailDescription" minOccurs="0"/>
      <element ref="cor:monetaryAmount" minOccurs="0"/>
      <element ref="cor:currency" minOccurs="0"/>
      <element ref="cor:signIndicationForAmount" minOccurs="0"/>
      <element ref="cor:debitCreditIndicator" minOccurs="0"/>
      <element ref="cor:allocationCode" minOccurs="0"/>
