      <element ref="cor:chargeableOrReimbursable" minOccurs="0"/>
      <element ref="cor:paymentMethod" minOccurs="0"/>
      <element ref="cor:shipFrom" minOccurs="0"/>
      <element ref="cor:dateShippedReceived" minOccurs="0"/>
      <element ref="cor:maturityDateOrDateDue" minOccurs="0"/>
      <element ref="cor:paymentTerms" minOccurs="0"/>
      <element ref="cor:costingMethodCode" minOccurs="0"/>
      <element ref="cor:costingMethodDescription" minOccurs="0"/>
      <element ref="cor:tickingField" minOccurs="0"/>
      <element ref="cor:documentRemainingBalance" minOccurs="0"/>
      <element ref="cor:ucr" minOccurs="0"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="detailDocumentComplexType">
    <sequence>
      <element ref="cor:detailDocumentNumber" minOccurs="0"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
</schema>
