<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.xbrl.org/int/gl/cor/2026-12-31" elementFormDefault="qualified" attributeFormDefault="unqualified"
  xmlns="http://www.w3.org/2001/XMLSchema"
  xmlns:xbrli="http://www.xbrl.org/2003/instance"
  xmlns:cor="http://www.xbrl.org/int/gl/cor/2026-12-31"
  xmlns:bus="http://www.xbrl.org/int/gl/bus/2026-12-31"
  xmlns:lnk="http://www.xbrl.org/int/gl/lnk/2026-12-31"
>
  <import namespace="http://www.xbrl.org/2003/instance" schemaLocation="http://www.xbrl.org/2003/xbrl-instance-2003-12-31.xsd"/>
  <include schemaLocation="../../cor/cor-2026-12-31.xsd"/>
  <import namespace="http://www.xbrl.org/int/gl/bus/2026-12-31" schemaLocation="bus-content-2026-12-31.xsd"/>
  <import namespace="http://www.xbrl.org/int/gl/lnk/2026-12-31" schemaLocation="lnk-content-2026-12-31.xsd"/>
  <!-- HMD-specific Tuple element -->
  <element name="transactionDocumentInformation" id="cor_transactionDocumentInformation" type="cor:transactionDocumentInformationComplexType" substitutionGroup="xbrli:tuple" nillable="false"/>
  <element name="entityParty" id="cor_entityParty" type="cor:entityPartyComplexType" substitutionGroup="xbrli:tuple" nillable="false"/>
  <element name="externalAuthority" id="cor_externalAuthority" type="cor:externalAuthorityComplexType" substitutionGroup="xbrli:tuple" nillable="false"/>
  <element name="identifierPhone" id="cor_identifierPhone" type="cor:identifierPhoneComplexType" substitutionGroup="xbrli:tuple" nillable="false"/>
  <element name="identifierFax" id="cor_identifierFax" type="cor:identifierFaxComplexType" substitutionGroup="xbrli:tuple" nillable="false"/>
  <element name="identifierEmail" id="cor_identifierEmail" type="cor:identifierEmailComplexType" substitutionGroup="xbrli:tuple" nillable="false"/>
  <element name="identifierAddress" id="cor_identifierAddress" type="cor:identifierAddressComplexType" substitutionGroup="xbrli:tuple" nillable="false"/>
  <element name="identifierContact" id="cor_identifierContact" type="cor:identifierContactComplexType" substitutionGroup="xbrli:tuple" nillable="false"/>
  <element name="document" id="cor_document" type="cor:documentComplexType" substitutionGroup="xbrli:tuple" nillable="false"/>
  <!-- HMD-specific structural type -->
  <complexType name="transactionDocumentInformationComplexType">
    <sequence>
      <element ref="cor:transactionDocumentType"/>
      <element ref="cor:transactionAuditNumber" minOccurs="0"/>
      <element ref="cor:transactionRevisesAuditNumber" minOccurs="0"/>
      <element ref="cor:transactionActionToTakeWithPreviousData" minOccurs="0"/>
      <element ref="cor:transactionLanguage" minOccurs="0"/>
      <element ref="cor:transactionCreationDate" minOccurs="0"/>
      <element ref="cor:transactionCreator" minOccurs="0"/>
      <element ref="cor:transactionDocumentComment" minOccurs="0"/>
      <element ref="cor:transactionPeriodCoveredStart" minOccurs="0"/>
      <element ref="cor:transactionPeriodCoveredEnd" minOccurs="0"/>
      <element ref="cor:transactionPeriodCount" minOccurs="0"/>
      <element ref="cor:transactionPeriodUnit" minOccurs="0"/>
      <element ref="cor:transactionPeriodUnitDescription" minOccurs="0"/>
      <element ref="cor:transactionSourceApplication" minOccurs="0"/>
      <element ref="cor:transactionTargetApplication" minOccurs="0"/>
      <element ref="cor:transactionDefaultCurrency" minOccurs="0"/>
      <element ref="lnk:transactionSummaryReportingTaxonomies" minOccurs="0" maxOccurs="unbounded"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="entityPartyComplexType">
    <sequence>
      <element ref="cor:entityPartyName" minOccurs="0"/>
      <element ref="cor:entityPartyId" minOccurs="0"/>
      <element ref="cor:entityPartyBusinessDescription" minOccurs="0"/>
      <element ref="bus:entityPartyPhone" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityPartyFax" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityPartyEmail" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityPartyRegisteredOrganizationIdentifier" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityPartyAddress" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityPartyWebSite" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityPartyContact" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="cor:entityDefaultAccountingMethodPurpose" minOccurs="0"/>
      <element ref="cor:entityDefaultAccountingMethodPurposeDescription" minOccurs="0"/>
      <element ref="cor:entityFiscalYearStart" minOccurs="0"/>
      <element ref="cor:entityFiscalYearEnd" minOccurs="0"/>
      <element ref="bus:entitySpecifiedAccountingMethodStructure" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entityAssignedAccountant" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:entitySpecifiedReportingCalendar" minOccurs="0" maxOccurs="unbounded"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="externalAuthorityComplexType">
    <sequence>
      <element ref="cor:externalAuthorityCode" minOccurs="0"/>
      <element ref="cor:externalAuthorityName" minOccurs="0"/>
      <element ref="cor:externalAuthorityVerificationDate" minOccurs="0"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="identifierPhoneComplexType">
    <sequence>
      <element ref="cor:phoneNumber" minOccurs="0"/>
      <element ref="cor:phoneNumberDescription" minOccurs="0"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="identifierFaxComplexType">
    <sequence>
      <element ref="cor:faxNumber" minOccurs="0"/>
      <element ref="cor:faxNumberUsage" minOccurs="0"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="identifierEmailComplexType">
    <sequence>
      <element ref="cor:emailAddress" minOccurs="0"/>
      <element ref="cor:emailAddressUsage" minOccurs="0"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="identifierAddressComplexType">
    <sequence>
      <element ref="cor:identifierAddressDescription" minOccurs="0"/>
      <element ref="cor:purpose" minOccurs="0"/>
      <element ref="cor:locationId" minOccurs="0"/>
      <element ref="cor:buildingNumber" minOccurs="0"/>
      <element ref="cor:street" minOccurs="0"/>
      <element ref="cor:addressDetail" minOccurs="0"/>
      <element ref="cor:city" minOccurs="0"/>
      <element ref="cor:stateOrProvince" minOccurs="0"/>
      <element ref="cor:country" minOccurs="0"/>
      <element ref="cor:zipOrPostalCode" minOccurs="0"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="identifierContactComplexType">
    <sequence>
      <element ref="cor:contactPrefix" minOccurs="0"/>
      <element ref="cor:contactLastName" minOccurs="0"/>
      <element ref="cor:contactFirstName" minOccurs="0"/>
      <element ref="cor:contactSuffix" minOccurs="0"/>
      <element ref="cor:contactAttentionLine" minOccurs="0"/>
      <element ref="cor:contactPositionRole" minOccurs="0"/>
      <element ref="cor:contactContactType" minOccurs="0"/>
      <element ref="cor:contactLocationIdCrossReference" minOccurs="0"/>
      <element ref="cor:contactActive" minOccurs="0"/>
      <element ref="bus:contactPhone" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:contactFax" minOccurs="0" maxOccurs="unbounded"/>
      <element ref="bus:contactEmail" minOccurs="0" maxOccurs="unbounded"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
  <complexType name="documentComplexType">
    <sequence>
      <element ref="cor:documentNumber" minOccurs="0"/>
    </sequence>
    <attribute name="id" type="ID"/>
  </complexType>
</schema>
