    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_detailDescription" xlink:to="doc_jnl_detailDescription"/>
    <loc xlink:type="locator" xlink:href="../jnl-oim-2026-12-31.xsd#jnl_monetaryAmount" xlink:label="loc_jnl_monetaryAmount"/>
    <label xlink:type="resource" xlink:label="lab_jnl_monetaryAmount" xlink:role="http://www.xbrl.org/2003/role/label" xml:lang="en">Monetary Amount</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_monetaryAmount" xlink:to="lab_jnl_monetaryAmount"/>
    <label xlink:type="resource" xlink:label="doc_jnl_monetaryAmount" xlink:role="http://www.xbrl.org/2003/role/documentation" xml:lang="en">This field (amount) represents the primary monetary amount related to the  subject of the entryDetail line. There is one primary monetary amount per entryDetail class. It may, for example, represent the amount of one line of a journal entry, the balance on a document, or the extended amount of a line item on an invoice. Amount is not required if detailed entry is used for non-financial work and other elements are populated, in particular measurableQuantity. The amount field is a signed number (either positive or negative itself) and used in conjunction with a separate signOfAmount and a separate debitCreditCode, which together are considered for understanding the monetary amount. The unit of measure is determined by amountCurrency if present, and by the default or home currency if amountCurrency is not present.</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_monetaryAmount" xlink:to="doc_jnl_monetaryAmount"/>
    <loc xlink:type="locator" xlink:href="../jnl-oim-2026-12-31.xsd#jnl_currency" xlink:label="loc_jnl_currency"/>
    <label xlink:type="resource" xlink:label="lab_jnl_currency" xlink:role="http://www.xbrl.org/2003/role/label" xml:lang="en">Currency</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_currency" xlink:to="lab_jnl_currency"/>
    <label xlink:type="resource" xlink:label="doc_jnl_currency" xlink:role="http://www.xbrl.org/2003/role/documentation" xml:lang="en">The currency related to the amount can be entered here instead of the XBRL instance specified way, especially important in multi-currency situations. Recommend ISO 4217 coding.</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_currency" xlink:to="doc_jnl_currency"/>
    <loc xlink:type="locator" xlink:href="../jnl-oim-2026-12-31.xsd#jnl_signIndicationForAmount" xlink:label="loc_jnl_signIndicationForAmount"/>
    <label xlink:type="resource" xlink:label="lab_jnl_signIndicationForAmount" xlink:role="http://www.xbrl.org/2003/role/label" xml:lang="en">Sign Indication for Amount</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_signIndicationForAmount" xlink:to="lab_jnl_signIndicationForAmount"/>
    <label xlink:type="resource" xlink:label="doc_jnl_signIndicationForAmount" xlink:role="http://www.xbrl.org/2003/role/documentation" xml:lang="en">Sign of amount; provides 4 possible fields only when used in conjunction with debitCreditCode; primarily used for correcting entries so total debits and credits after an entry error are not inflated. D + increase DebitsD - decrease debitsC + decreases creditC - increases credit</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_signIndicationForAmount" xlink:to="doc_jnl_signIndicationForAmount"/>
