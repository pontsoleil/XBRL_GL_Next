    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_accountClassification" xlink:to="lab_jnl_accountClassification"/>
    <label xlink:type="resource" xlink:label="doc_jnl_accountClassification" xlink:role="http://www.xbrl.org/2003/role/documentation" xml:lang="en">Account type - FASB Concepts 6 and similar international designs. When xbrlInfo is used to associated other XBRL reporting items, this field is more suited to representing existing systems (audit) than data interchange. Enumerated as: asset, liability, equity, income, gain, expense, loss, contr-to-equity, distr-from-equity, comprehensive-income, other.</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_accountClassification" xlink:to="doc_jnl_accountClassification"/>
    <loc xlink:type="locator" xlink:href="../jnl-oim-2026-12-31.xsd#jnl_accountClassificationDescription" xlink:label="loc_jnl_accountClassificationDescription"/>
    <label xlink:type="resource" xlink:label="lab_jnl_accountClassificationDescription" xlink:role="http://www.xbrl.org/2003/role/label" xml:lang="en">Account Classification Description</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_accountClassificationDescription" xlink:to="lab_jnl_accountClassificationDescription"/>
    <label xlink:type="resource" xlink:label="doc_jnl_accountClassificationDescription" xlink:role="http://www.xbrl.org/2003/role/documentation" xml:lang="en">Free format description of the account classification</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_accountClassificationDescription" xlink:to="doc_jnl_accountClassificationDescription"/>
    <loc xlink:type="locator" xlink:href="../jnl-oim-2026-12-31.xsd#p_jnl_subaccount" xlink:label="loc_p_jnl_subaccount"/>
