    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_p_jnl_subaccount" xlink:to="lab_p_jnl_subaccount"/>
    <label xlink:type="resource" xlink:label="doc_p_jnl_subaccount" xlink:role="http://www.xbrl.org/2003/role/documentation" xml:lang="en">Class to hold multiple accountSubIDs and Descriptions</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_p_jnl_subaccount" xlink:to="doc_p_jnl_subaccount"/>
    <loc xlink:type="locator" xlink:href="../jnl-oim-2026-12-31.xsd#jnl_subaccountDescription" xlink:label="loc_jnl_subaccountDescription"/>
    <label xlink:type="resource" xlink:label="lab_jnl_subaccountDescription" xlink:role="http://www.xbrl.org/2003/role/label" xml:lang="en">Subaccount Description</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_subaccountDescription" xlink:to="lab_jnl_subaccountDescription"/>
    <label xlink:type="resource" xlink:label="doc_jnl_subaccountDescription" xlink:role="http://www.xbrl.org/2003/role/documentation" xml:lang="en">The description that accompanies accountSubID belongs here.</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_subaccountDescription" xlink:to="doc_jnl_subaccountDescription"/>
    <loc xlink:type="locator" xlink:href="../jnl-oim-2026-12-31.xsd#jnl_subaccountId" xlink:label="loc_jnl_subaccountId"/>
    <label xlink:type="resource" xlink:label="lab_jnl_subaccountId" xlink:role="http://www.xbrl.org/2003/role/label" xml:lang="en">Subaccount ID</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_subaccountId" xlink:to="lab_jnl_subaccountId"/>
    <label xlink:type="resource" xlink:label="doc_jnl_subaccountId" xlink:role="http://www.xbrl.org/2003/role/documentation" xml:lang="en">Where the primary account was placed in accountMainID, the code used for each profit center, division, business unit, fund, program, branch, project, class, su-class or other modifier is placed here.</label>
    <labelArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/concept-label" xlink:from="loc_jnl_subaccountId" xlink:to="doc_jnl_subaccountId"/>
    <loc xlink:type="locator" xlink:href="../jnl-oim-2026-12-31.xsd#jnl_type" xlink:label="loc_jnl_type"/>
    <label xlink:type="resource" xlink:label="lab_jnl_type" xlink:role="http://www.xbrl.org/2003/role/label" xml:lang="en">Type</label>
